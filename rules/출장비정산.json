{
  "file": "출장비정산",
  "columns": ["신청번호", "사번", "부서", "출장일", "출장지", "박수", "교통비", "숙박비"],
  "row_id": "신청번호",
  "flag_column": "_표시",
  "order_note": "위에서 아래 순서대로 적용한다. 모양을 맞추는 처방이 먼저, 표시하는 처방이 다음, 같은 줄 지우기가 마지막이다.",
  "rules": [
    {
      "id": "출장지-이름",
      "title": "출장지: «광주광역시» «부산시» «대전시»를 광주 · 부산 · 대전으로",
      "type": "replace",
      "columns": ["출장지"],
      "map": { "광주광역시": "광주", "부산시": "부산", "대전시": "대전" },
      "why": "같은 곳임",
      "owner": "eunju"
    },
    {
      "id": "박수-모양",
      "title": "박수: «박»을 떼고 «당일»은 0",
      "type": "number",
      "columns": ["박수"],
      "map": { "당일": 0 },
      "remove": ["박"],
      "fail_flag": "숫자로 바꿀 수 없음: {칸}",
      "why": "뜻은 같고 모양만 다름",
      "owner": "eunju"
    },
    {
      "id": "금액-숫자로",
      "title": "교통비 · 숙박비: «원»과 쉼표를 떼고 숫자로",
      "type": "number",
      "columns": ["교통비", "숙박비"],
      "remove": ["원", ","],
      "fail_flag": "숫자로 바꿀 수 없음: {칸}",
      "why": "글자로 된 금액은 더할 수 없음",
      "owner": "eunju"
    },
    {
      "id": "출장일-형식",
      "title": "출장일: 날짜 표기를 2026-01-07 하나로. 단 «25/7/23»처럼 연도가 두 자리라 뜻이 갈리는 것은 고치지 않고 표시",
      "type": "date",
      "columns": ["출장일"],
      "target": "YYYY-MM-DD",
      "read_formats": ["YYYY-MM-DD", "YYYY.MM.DD", "YYYY.MM.DD.", "YYYY/MM/DD", "M/D/YYYY", "YYYY년 M월 D일"],
      "flag_patterns": [
        { "match": "^\\d{1,2}\\D+\\d{1,2}\\D+\\d{1,2}$", "flag": "연도가 두 자리라 날짜를 정할 수 없음: {칸}" }
      ],
      "fail_flag": "날짜로 읽을 수 없음: {칸}",
      "why": "모르는 날짜를 지어내지 않음",
      "owner": "eunju"
    },
    {
      "id": "부서-정식이름",
      "title": "부서: 앞뒤 공백을 지우고 «개발» «생산 팀» 같은 것을 정식 이름으로",
      "type": "replace",
      "columns": ["부서"],
      "trim": true,
      "map": {
        "개발": "개발팀",
        "생산 팀": "생산팀",
        "생산부": "생산팀",
        "재무 팀": "재무팀",
        "재무부": "재무팀",
        "인사부": "인사팀",
        "HR팀": "인사팀",
        "구매부": "구매팀",
        "마케팅": "마케팅팀",
        "마케팅 팀": "마케팅팀",
        "품질관리팀": "품질팀",
        "QA팀": "품질팀",
        "영업 팀": "영업팀",
        "영업부": "영업팀"
      },
      "why": "같은 부서를 다르게 적음",
      "owner": "eunju"
    },
    {
      "id": "부서-회계팀",
      "title": "부서: «회계팀»을 재무팀으로",
      "type": "replace",
      "columns": ["부서"],
      "trim": true,
      "map": { "회계팀": "재무팀" },
      "why": "표준 부서는 8개뿐이고 회계팀은 재무팀임",
      "owner": "eunju"
    },
    {
      "id": "박수-0",
      "title": "박수: 0은 그대로 둠",
      "type": "keep",
      "columns": ["박수"],
      "when": { "column": "박수", "op": "=", "value": 0 },
      "why": "당일 출장인 경우임",
      "owner": "eunju"
    },
    {
      "id": "빈칸",
      "title": "빈칸(신청번호 · 사번 · 부서 · 출장일 · 출장지 · 박수 · 교통비 · 숙박비): 채우지 않고 표시",
      "type": "flag",
      "columns": ["신청번호", "사번", "부서", "출장일", "출장지", "박수", "교통비", "숙박비"],
      "each_column": { "op": "blank" },
      "flag": "빈칸: {칸}",
      "why": "모르는 값을 지어내지 않음",
      "owner": "eunju"
    },
    {
      "id": "금액-음수",
      "title": "교통비 · 숙박비: 음수이면 남기고 표시",
      "type": "flag",
      "columns": ["교통비", "숙박비"],
      "each_column": { "op": "<", "value": 0 },
      "flag": "음수: {칸}",
      "why": "환불인지 확인 필요",
      "owner": "eunju"
    },
    {
      "id": "금액-너무-큼",
      "title": "교통비가 200,000을 넘거나 숙박비가 500,000을 넘으면 남기고 표시",
      "type": "flag",
      "columns": ["교통비", "숙박비"],
      "by_column": {
        "교통비": { "op": ">", "value": 200000 },
        "숙박비": { "op": ">", "value": 500000 }
      },
      "flag": "금액이 큼: {칸}",
      "why": "0을 하나 더 친 것 같지만 진짜 값은 모름",
      "owner": "eunju"
    },
    {
      "id": "박수-3초과",
      "title": "박수가 3일을 넘으면 남기고 표시",
      "type": "flag",
      "columns": ["박수"],
      "each_column": { "op": ">", "value": 3 },
      "flag": "박수가 3을 넘음",
      "why": "진짜 값인지 확인 필요",
      "owner": "eunju"
    },
    {
      "id": "박수0-숙박비",
      "title": "박수가 0인데 숙박비가 0보다 크면 표시",
      "type": "flag",
      "columns": ["박수", "숙박비"],
      "when": {
        "all": [
          { "column": "박수", "op": "=", "value": 0 },
          { "column": "숙박비", "op": ">", "value": 0 }
        ]
      },
      "flag": "박수 0인데 숙박비 있음",
      "why": "어느 칸이 틀렸는지 모름",
      "owner": "eunju"
    },
    {
      "id": "사번-부서-하나",
      "title": "같은 사번인데 부서가 둘 이상이면 그 사번의 줄을 모두 표시",
      "type": "consistent",
      "columns": ["사번", "부서"],
      "group_by": "사번",
      "column": "부서",
      "flag": "같은 사번에 부서가 둘 이상",
      "why": "어느 부서가 맞는지 모름",
      "owner": "eunju"
    },
    {
      "id": "같은-줄",
      "title": "모양을 다 맞춘 뒤 완전히 같은 줄은 하나만 남긴다",
      "type": "dedupe",
      "columns": ["신청번호", "사번", "부서", "출장일", "출장지", "박수", "교통비", "숙박비"],
      "keep": "first",
      "why": "같은 신청을 두 번 올림",
      "owner": "eunju"
    }
  ]
}
